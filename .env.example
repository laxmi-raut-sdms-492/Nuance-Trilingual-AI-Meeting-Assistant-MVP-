# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg://nuance:nuance_dev_pw@localhost:5432/nuance

# STT Adapter Selection: local | cloud
STT_ADAPTER=local

# Cloud STT Provider Choice: sarvam | google
CLOUD_STT_PROVIDER=sarvam

# Sarvam STT Credentials (saaras:v3)
SARVAM_API_KEY=

# Google Cloud STT Credentials (chirp_3)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Local STT Models
WHISPER_MODEL_SIZE=medium
INDIC_CONFORMER_MODEL=ai4bharat/indic-conformer-600m-multilingual

# Ollama LLM Summarization
SUMMARY_ENABLED=1
OLLAMA_URL=http://localhost:11434
SUMMARY_MODEL=qwen2.5:7b
