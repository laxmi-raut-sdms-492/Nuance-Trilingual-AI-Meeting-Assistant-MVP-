# Copy to .env (or export in your shell) and fill in real values.
# Nothing here is required for local-only processing_mode meetings.

# --- Database ---
DATABASE_URL=postgresql+psycopg://nuance:nuance_dev_pw@localhost:5432/nuance

# --- STT processing mode ---
# Fallback used only for meetings whose own processing_mode column is
# NULL/missing. Per-meeting selection happens via the API, not this var.
DEFAULT_PROCESSING_MODE=local
CLOUD_STT_DEFAULT_PROVIDER=sarvam

# --- Sarvam (cloud STT provider) ---
# Required only if any meeting uses processing_mode=cloud with provider=sarvam.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TIMEOUT_SECONDS=30

# --- Summarization (local Ollama) ---
SUMMARY_ENABLED=1
OLLAMA_URL=http://localhost:11434
SUMMARY_MODEL=qwen2.5:7b
